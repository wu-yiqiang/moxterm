<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoxTerm.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="24,20,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与说明 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind Loc.NavPingTraceroute, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Loc.DiagSubtitle, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 诊断失败提示 -->
        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <!-- 工具栏：目标主机与操作 -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="HostBox"
                Width="280"
                Header="{x:Bind Loc.DiagHostLabel, Mode=OneWay}"
                PlaceholderText="{x:Bind Loc.DiagHostPlaceholder, Mode=OneWay}" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="PingButton"
                    Click="OnPingClick"
                    Content="{x:Bind Loc.DiagPing, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="TracerouteButton"
                    Click="OnTracerouteClick"
                    Content="{x:Bind Loc.DiagTraceroute, Mode=OneWay}" />
                <Button
                    x:Name="StopButton"
                    Click="OnStopClick"
                    Content="{x:Bind Loc.DiagStop, Mode=OneWay}"
                    IsEnabled="False" />
                <Button
                    x:Name="ClearButton"
                    Click="OnClearClick"
                    Content="{x:Bind Loc.DiagClear, Mode=OneWay}"
                    IsEnabled="False" />
            </StackPanel>
        </Grid>

        <!-- 输出：等宽字体逐行展示诊断结果 -->
        <Border
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <ListView
                    x:Name="OutputList"
                    Padding="8,4"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                FontFamily="{StaticResource TerminalFontFamily}"
                                FontSize="13"
                                IsTextSelectionEnabled="True"
                                Text="{Binding}"
                                TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="EmptyText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsHitTestVisible="False"
                    Text="{x:Bind Loc.DiagEmpty, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="4"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
