<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoxTerm.Views.NetworkScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="24,20,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与说明 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind Loc.NavNetScan, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Loc.NetScanSubtitle, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 扫描失败提示 -->
        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <!-- 工具栏：扫描范围与操作 -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="RangeBox"
                Header="{x:Bind Loc.NetScanRangeLabel, Mode=OneWay}"
                PlaceholderText="{x:Bind Loc.NetScanRangePlaceholder, Mode=OneWay}" />

            <Button
                x:Name="LocalSubnetButton"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Click="OnLocalSubnetClick"
                Content="{x:Bind Loc.NetScanLocalSubnet, Mode=OneWay}" />

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="StartButton"
                    Click="OnScanClick"
                    Content="{x:Bind Loc.NetScanStart, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="StopButton"
                    Click="OnStopClick"
                    Content="{x:Bind Loc.NetScanStop, Mode=OneWay}"
                    IsEnabled="False" />
                <Button
                    x:Name="ClearButton"
                    Click="OnClearClick"
                    Content="{x:Bind Loc.NetScanClear, Mode=OneWay}"
                    IsEnabled="False" />
                <Button
                    x:Name="ExportButton"
                    Click="OnExportClick"
                    Content="{x:Bind Loc.NetScanExport, Mode=OneWay}"
                    IsEnabled="False" />
            </StackPanel>
        </Grid>

        <!-- 在线主机列表 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Margin="20,0,20,4"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Loc.NetScanColAddress, Mode=OneWay}"
                    TextAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Loc.NetScanColHostName, Mode=OneWay}"
                    TextAlignment="Center" />
                <TextBlock
                    Grid.Column="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Loc.NetScanColMac, Mode=OneWay}"
                    TextAlignment="Center" />
                <StackPanel
                    Grid.Column="3"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Width="52"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="SSH"
                        TextAlignment="Center" />
                    <TextBlock
                        Width="52"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="RDP"
                        TextAlignment="Center" />
                    <TextBlock
                        Width="52"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="VNC"
                        TextAlignment="Center" />
                    <TextBlock
                        Width="52"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="FTP"
                        TextAlignment="Center" />
                    <TextBlock
                        Width="52"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Telnet"
                        TextAlignment="Center" />
                    <TextBlock
                        Width="52"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Rlogin"
                        TextAlignment="Center" />
                    <TextBlock
                        Width="52"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="HTTP"
                        TextAlignment="Center" />
                </StackPanel>
                <TextBlock
                    Grid.Column="4"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Loc.NetScanColLatency, Mode=OneWay}"
                    TextAlignment="Center" />
            </Grid>

            <ListView
                x:Name="HostsList"
                Grid.Row="1"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <StaticResource ResourceKey="SelectableRowItemStyle" />
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            MinHeight="34"
                            Padding="8,4"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{Binding IpText}"
                                TextAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding HostNameText}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                FontFamily="Consolas"
                                Text="{Binding MacText}"
                                TextAlignment="Center" />
                            <ItemsControl
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding ServiceCells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <FontIcon
                                            Width="52"
                                            FontSize="12"
                                            Foreground="{Binding Brush}"
                                            Glyph="{Binding Glyph}"
                                            HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                Grid.Column="4"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding LatencyText}"
                                TextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="EmptyText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsHitTestVisible="False"
                Text="{x:Bind Loc.NetScanEmpty, Mode=OneWay}"
                TextWrapping="Wrap" />
        </Grid>

        <!-- 状态栏 -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="4"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
