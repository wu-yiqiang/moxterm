<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoxTerm.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoxTerm.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- 设置页的分组卡片 -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- 设置行：左图标 + 标题/说明，右侧承载设置控件 -->
        <Style TargetType="controls:SettingsRow">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:SettingsRow">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Visibility="{TemplateBinding DividerVisibility}" />

                            <Grid
                                Grid.Row="1"
                                MinHeight="68"
                                Padding="20,12,16,12"
                                ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--
                                    SymbolIcon 没有 FontSize（用 FontIcon 才能自定义字号），
                                    默认按符号字体自身的尺寸渲染，正好与卡片式设置的图标大小相称。
                                -->
                                <SymbolIcon
                                    x:Name="GlyphIcon"
                                    Grid.Column="0"
                                    Width="20"
                                    HorizontalAlignment="Center"
                                    Symbol="{TemplateBinding Glyph}"
                                    VerticalAlignment="Center" />

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{TemplateBinding Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{TemplateBinding Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <ContentPresenter
                                    Grid.Column="2"
                                    Content="{TemplateBinding Content}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            Padding="36,28,36,36"
            Spacing="24">

            <TextBlock Text="{x:Bind Loc.SettingsTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Loc.GroupAppearance, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <controls:SettingsRow
                            Title="{x:Bind Loc.Language, Mode=OneWay}"
                            Description="{x:Bind Loc.LanguageDesc, Mode=OneWay}"
                            DividerVisibility="Collapsed"
                            Glyph="World"
                            GlyphCode="&#xE8C1;">
                            <ComboBox
                                x:Name="LanguageComboBox"
                                Width="200"
                                SelectionChanged="OnLanguageChanged" />
                        </controls:SettingsRow>

                        <controls:SettingsRow
                            Title="{x:Bind Loc.Theme, Mode=OneWay}"
                            Description="{x:Bind Loc.ThemeDesc, Mode=OneWay}"
                            Glyph="Setting"
                            GlyphCode="&#xE771;">
                            <ComboBox
                                x:Name="ThemeComboBox"
                                Width="200"
                                SelectionChanged="OnThemeChanged" />
                        </controls:SettingsRow>

                        <controls:SettingsRow
                            Title="{x:Bind Loc.ColorScheme, Mode=OneWay}"
                            Description="{x:Bind Loc.ColorSchemeDesc, Mode=OneWay}"
                            Glyph="FontColor">
                            <ComboBox
                                x:Name="ColorSchemeComboBox"
                                Width="200"
                                SelectionChanged="OnColorSchemeChanged" />
                        </controls:SettingsRow>

                        <controls:SettingsRow
                            Title="{x:Bind Loc.Font, Mode=OneWay}"
                            Description="{x:Bind Loc.FontDesc, Mode=OneWay}"
                            Glyph="Font">
                            <ComboBox
                                x:Name="FontFamilyComboBox"
                                Width="200"
                                SelectionChanged="OnFontFamilyChanged" />
                        </controls:SettingsRow>

                        <controls:SettingsRow
                            Title="{x:Bind Loc.FontSize, Mode=OneWay}"
                            Description="{x:Bind Loc.FontSizeDesc, Mode=OneWay}"
                            Glyph="FontSize">
                            <NumberBox
                                x:Name="FontSizeBox"
                                Width="200"
                                Maximum="32"
                                Minimum="8"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnFontSizeChanged" />
                        </controls:SettingsRow>

                        <controls:SettingsRow
                            Title="{x:Bind Loc.LineHeight, Mode=OneWay}"
                            Description="{x:Bind Loc.LineHeightDesc, Mode=OneWay}"
                            Glyph="List">
                            <NumberBox
                                x:Name="LineHeightBox"
                                Width="200"
                                Maximum="2"
                                Minimum="1"
                                SmallChange="0.05"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnLineHeightChanged" />
                        </controls:SettingsRow>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Loc.GroupTerminal, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <controls:SettingsRow
                            Title="{x:Bind Loc.DefaultShell, Mode=OneWay}"
                            Description="{x:Bind Loc.DefaultShellDesc, Mode=OneWay}"
                            DividerVisibility="Collapsed"
                            Glyph="Repair"
                            GlyphCode="&#xE756;">
                            <ComboBox
                                x:Name="DefaultShellComboBox"
                                Width="200"
                                SelectionChanged="OnDefaultShellChanged" />
                        </controls:SettingsRow>

                        <!-- 起始目录：卡内折叠行，点击头部展开/收起详细设置 -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Height="1"
                                VerticalAlignment="Top"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Button
                                Grid.Row="0"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnWorkingDirHeaderClick">
                                <Grid
                                    MinHeight="68"
                                    Padding="20,12,16,12"
                                    ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <SymbolIcon
                                        Grid.Column="0"
                                        Width="20"
                                        HorizontalAlignment="Center"
                                        Symbol="Folder"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Loc.WorkingDir, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <!-- 当前值摘要：折叠时与箭头一起显示在右侧 -->
                                    <TextBlock
                                        x:Name="WorkingDirectorySummary"
                                        Grid.Column="2"
                                        MaxWidth="360"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextAlignment="Right"
                                        TextTrimming="CharacterEllipsis" />

                                    <FontIcon
                                        x:Name="WorkingDirChevron"
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE70D;" />
                                </Grid>
                            </Button>

                            <Border
                                x:Name="WorkingDirPanel"
                                Grid.Row="1"
                                Padding="58,16,20,16"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                Visibility="Collapsed">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBox
                                            x:Name="WorkingDirectoryBox"
                                            Width="200"
                                            LostFocus="OnWorkingDirectoryLostFocus"
                                            PlaceholderText="{x:Bind Loc.WorkingDirEmpty, Mode=OneWay}" />
                                        <Button
                                            x:Name="BrowseButton"
                                            Click="OnBrowseClick"
                                            Content="{x:Bind Loc.Browse, Mode=OneWay}" />
                                    </StackPanel>
                                    <CheckBox
                                        x:Name="UseParentDirCheckBox"
                                        Checked="OnUseParentDirToggled"
                                        Content="{x:Bind Loc.UseParentDir, Mode=OneWay}"
                                        Unchecked="OnUseParentDirToggled" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <controls:SettingsRow
                            Title="{x:Bind Loc.Scrollback, Mode=OneWay}"
                            Description="{x:Bind Loc.ScrollbackDesc, Mode=OneWay}"
                            Glyph="Clock"
                            GlyphCode="&#xE81C;">
                            <NumberBox
                                x:Name="ScrollbackBox"
                                Width="200"
                                Maximum="100000"
                                Minimum="200"
                                SmallChange="100"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnScrollbackChanged" />
                        </controls:SettingsRow>

                        <controls:SettingsRow
                            Title="{x:Bind Loc.CursorShape, Mode=OneWay}"
                            Description="{x:Bind Loc.CursorShapeDesc, Mode=OneWay}"
                            Glyph="Target">
                            <ComboBox
                                x:Name="CursorStyleComboBox"
                                Width="200"
                                SelectionChanged="OnCursorStyleChanged" />
                        </controls:SettingsRow>

                        <controls:SettingsRow
                            Title="{x:Bind Loc.CursorBlink, Mode=OneWay}"
                            Description="{x:Bind Loc.CursorBlinkDesc, Mode=OneWay}"
                            Glyph="Sync"
                            GlyphCode="&#xE706;">
                            <!-- 只显示药丸并清除主题 MinWidth，否则药丸在加宽的控件框内左对齐，右侧留空 -->
                            <ToggleSwitch
                                x:Name="CursorBlinkSwitch"
                                MinWidth="0"
                                Toggled="OnCursorBlinkToggled" />
                        </controls:SettingsRow>

                        <controls:SettingsRow
                            x:Name="BackendRow"
                            Title="{x:Bind Loc.Backend, Mode=OneWay}"
                            Glyph="Library"
                            GlyphCode="&#xE7F4;">
                            <ComboBox
                                x:Name="BackendComboBox"
                                Width="200"
                                SelectionChanged="OnBackendChanged" />
                        </controls:SettingsRow>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Loc.GroupInput, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <controls:SettingsRow
                            Title="{x:Bind Loc.ConfirmPaste, Mode=OneWay}"
                            Description="{x:Bind Loc.ConfirmPasteDesc, Mode=OneWay}"
                            DividerVisibility="Collapsed"
                            Glyph="Paste">
                            <ToggleSwitch
                                x:Name="ConfirmPasteSwitch"
                                MinWidth="0"
                                Toggled="OnConfirmPasteToggled" />
                        </controls:SettingsRow>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Loc.GroupAbout, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <controls:SettingsRow
                            x:Name="AboutRow"
                            Title="MoxTerm"
                            DividerVisibility="Collapsed"
                            Glyph="Help"
                            GlyphCode="&#xE946;" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
