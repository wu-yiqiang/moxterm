<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoxTerm.Views.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid>
        <!--
            WinUI 3 的 TabView 没有 IsClosable，关闭能力由每个 TabViewItem 决定，
            这里在创建标签页时统一设为可关闭。
            加号按钮点击后弹出会话类型菜单（本地 Shell + 远程协议）。
        -->
        <TabView
            x:Name="Tabs"
            AddTabButtonClick="OnAddTabButtonClick"
            AllowDropTabs="True"
            CanReorderTabs="True"
            HorizontalContentAlignment="Stretch"
            TabCloseRequested="OnTabCloseRequested"
            VerticalContentAlignment="Stretch">

            <TabView.Resources>
                <ResourceDictionary>
                    <!--
                        WinUI 的 ContentControl 内容默认左上对齐而不拉伸，
                        不显式设为 Stretch 时终端只会按文本高度撑开一条，填不满标签页。
                    -->
                    <Style TargetType="TabViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>

                    <!-- 当前标签标注：选中项提亮背景 + 文字全亮，未选中项半透明压暗 -->
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#FF2B2B2B" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelectedPointerOver" Color="#FF333333" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelectedPressed" Color="#FF282828" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="#00FFFFFF" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#14FFFFFF" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#0AFFFFFF" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="#99FFFFFF" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelectedPointerOver" Color="#FFFAFAFA" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelectedPressed" Color="#FFF5F5F5" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="#00FFFFFF" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#14000000" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#0A000000" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#FF1A1A1A" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="#8A000000" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </TabView.Resources>
        </TabView>
    </Grid>
</Page>
