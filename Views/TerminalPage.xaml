<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoxTerm.Views.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid>
        <!--
            WinUI 3 的 TabView 没有 IsClosable，关闭能力由每个 TabViewItem 决定，
            这里在创建标签页时统一设为可关闭。
            加号按钮点击后弹出会话类型菜单（本地 Shell + 远程协议）。
        -->
        <TabView
            x:Name="Tabs"
            AddTabButtonClick="OnAddTabButtonClick"
            AllowDropTabs="True"
            CanReorderTabs="True"
            HorizontalContentAlignment="Stretch"
            TabCloseRequested="OnTabCloseRequested"
            VerticalContentAlignment="Stretch">

            <TabView.Resources>
                <!--
                    WinUI 的 ContentControl 内容默认左上对齐而不拉伸，
                    不显式设为 Stretch 时终端只会按文本高度撑开一条，填不满标签页。
                -->
                <Style TargetType="TabViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </TabView.Resources>
        </TabView>
    </Grid>
</Page>
