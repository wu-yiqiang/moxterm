<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoxTerm.Views.PortScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="24,20,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与说明 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind Loc.NavPortScan, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Loc.PortScanSubtitle, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 扫描失败提示 -->
        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <!-- 工具栏：目标主机、端口范围与操作 -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="HostBox"
                Width="220"
                Header="{x:Bind Loc.PortScanHostLabel, Mode=OneWay}"
                PlaceholderText="{x:Bind Loc.PortScanHostPlaceholder, Mode=OneWay}" />

            <ComboBox
                x:Name="PresetBox"
                Grid.Column="1"
                MinWidth="130"
                VerticalAlignment="Bottom"
                SelectionChanged="OnPresetChanged" />

            <TextBox
                x:Name="PortsBox"
                Grid.Column="2"
                Header="{x:Bind Loc.PortScanPortsLabel, Mode=OneWay}"
                PlaceholderText="{x:Bind Loc.PortScanPortsPlaceholder, Mode=OneWay}" />

            <StackPanel
                Grid.Column="3"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="StartButton"
                    Click="OnScanClick"
                    Content="{x:Bind Loc.PortScanStart, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="StopButton"
                    Click="OnStopClick"
                    Content="{x:Bind Loc.PortScanStop, Mode=OneWay}"
                    IsEnabled="False" />
                <Button
                    x:Name="ClearButton"
                    Click="OnClearClick"
                    Content="{x:Bind Loc.PortScanClear, Mode=OneWay}"
                    IsEnabled="False" />
            </StackPanel>
        </Grid>

        <!-- 开放端口列表 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Margin="20,0,20,4"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Loc.PortScanColPort, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Loc.PortScanColService, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Loc.PortScanColBanner, Mode=OneWay}" />
            </Grid>

            <ListView
                x:Name="PortsList"
                Grid.Row="1"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <!-- 基于 WinUI 3 默认项样式，选中高亮沿用其默认圆角 -->
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            MinHeight="34"
                            Padding="8,4"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{Binding PortText}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Service}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding BannerText}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="EmptyText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsHitTestVisible="False"
                Text="{x:Bind Loc.PortScanEmpty, Mode=OneWay}"
                TextWrapping="Wrap" />
        </Grid>

        <!-- 状态栏 -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="4"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
