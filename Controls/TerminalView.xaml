<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MoxTerm.Controls.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    UseSystemFocusVisuals="False">

    <!-- 背景与前景的默认值来自主题资源，运行时会按配色设置覆盖 -->
    <Grid x:Name="Surface" Background="{ThemeResource TerminalBackgroundBrush}">
        <ScrollViewer
            x:Name="Scroller"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            Padding="10,8">
            <Grid>
                <TextBlock
                    x:Name="Screen"
                    FontFamily="{StaticResource TerminalFontFamily}"
                    Foreground="{ThemeResource TerminalForegroundBrush}"
                    IsTextSelectionEnabled="True"
                    TextWrapping="NoWrap" />

                <!-- 链接下划线：按字符网格绝对定位，随内容一起滚动，且不参与命中测试 -->
                <Canvas x:Name="LinkUnderlines" IsHitTestVisible="False" />
            </Grid>
        </ScrollViewer>

        <!-- 悬停在链接上时跟随指针的“打开链接”提示，本身可点击 -->
        <Border
            x:Name="LinkHint"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8,4"
            PointerEntered="OnLinkHintPointerEntered"
            Tapped="OnLinkHintTapped"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                <TextBlock x:Name="LinkHintText" FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
