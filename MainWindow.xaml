<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MoxTerm.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            自定义标题栏：内容延伸进标题栏区域，只有左侧放图标与标题，
            右侧空出来留给系统的最小化/最大化/关闭按钮。
        -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Height="44">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleBarIcon" Width="16" Height="16" />
                <TextBlock Text="MoxTerm" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Auto"
            OpenPaneLength="212"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind Loc.NavTerminal, Mode=OneWay}" Tag="terminal">
                    <NavigationViewItem.Icon>
                        <!-- 会话图标：对话气泡 -->
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="{x:Bind Loc.GroupTools, Mode=OneWay}"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Repair" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="{x:Bind Loc.NavNetServices, Mode=OneWay}" Tag="netsvc">
                            <NavigationViewItem.Icon>
                                <!-- Network：网络拓扑节点 -->
                                <FontIcon Glyph="&#xE968;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="{x:Bind Loc.NavTunneling, Mode=OneWay}" Tag="tunnel">
                            <NavigationViewItem.Icon>
                                <!-- VPN：加密隧道 -->
                                <FontIcon Glyph="&#xE705;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="{x:Bind Loc.NavKeyGen, Mode=OneWay}" Tag="keygen">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE8D7;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="{x:Bind Loc.NavOpenPorts, Mode=OneWay}" Tag="netports">
                            <NavigationViewItem.Icon>
                                <!-- NetworkAdapter：网卡适配器 -->
                                <FontIcon Glyph="&#xEDA3;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="{x:Bind Loc.NavWakeOnLan, Mode=OneWay}" Tag="wol">
                            <NavigationViewItem.Icon>
                                <!-- LightningBolt：闪电唤醒 -->
                                <FontIcon Glyph="&#xE945;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="{x:Bind Loc.NavNetScan, Mode=OneWay}" Tag="netscan">
                            <NavigationViewItem.Icon>
                                <!-- GatewayRouter：网关路由器 -->
                                <FontIcon Glyph="&#xEB77;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="{x:Bind Loc.NavPortScan, Mode=OneWay}" Tag="portscan">
                            <NavigationViewItem.Icon>
                                <!-- Radar：扫描探测 -->
                                <FontIcon Glyph="&#xEB44;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="{x:Bind Loc.NavPacketCapture, Mode=OneWay}" Tag="pktcap">
                            <NavigationViewItem.Icon>
                                <!-- EyeTracking：眼睛 + 取景框，表示捕获数据包 -->
                                <FontIcon Glyph="&#xEAD6;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="{x:Bind Loc.NavDiagnostics, Mode=OneWay}"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <!-- Diagnostic：心跳曲线 -->
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="{x:Bind Loc.NavPingTraceroute, Mode=OneWay}" Tag="diag">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE774;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="{x:Bind Loc.GroupServers, Mode=OneWay}"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AF;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="{x:Bind Loc.NavXServer, Mode=OneWay}" Tag="xserver">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE7F4;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <NavigationViewItem Content="{x:Bind Loc.NavShortcuts, Mode=OneWay}" Tag="shortcuts">
                    <NavigationViewItem.Icon>
                        <!-- Keyboard：键盘 -->
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 内置设置项只跟随系统语言，这里用自己的底部项以便接入应用内语言 -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsNavItem" Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
