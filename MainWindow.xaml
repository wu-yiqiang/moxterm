<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MoxTerm.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            自定义标题栏：内容延伸进标题栏区域，只有左侧放图标与标题，
            右侧空出来留给系统的最小化/最大化/关闭按钮。
        -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Height="44">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleBarIcon" Width="16" Height="16" />
                <TextBlock Text="MoxTerm" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            OpenPaneLength="212"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind Loc.NavTerminal, Mode=OneWay}" Tag="terminal">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="{x:Bind Loc.GroupTools, Mode=OneWay}"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Repair" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="{x:Bind Loc.NavNetServices, Mode=OneWay}" Tag="netsvc">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="List" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="{x:Bind Loc.NavTunneling, Mode=OneWay}" Tag="tunnel">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="Sync" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="{x:Bind Loc.NavKeyGen, Mode=OneWay}" Tag="keygen">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE8D7;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="{x:Bind Loc.NavOpenPorts, Mode=OneWay}" Tag="netports">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="Target" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="{x:Bind Loc.NavWakeOnLan, Mode=OneWay}" Tag="wol">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="Clock" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="{x:Bind Loc.NavNetScan, Mode=OneWay}" Tag="netscan">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="Refresh" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="{x:Bind Loc.NavPortScan, Mode=OneWay}" Tag="portscan">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="Accept" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="{x:Bind Loc.NavPacketCapture, Mode=OneWay}" Tag="pktcap">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="Folder" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="{x:Bind Loc.GroupServers, Mode=OneWay}"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AF;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="{x:Bind Loc.NavXServer, Mode=OneWay}" Tag="xserver">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE7F4;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 内置设置项只跟随系统语言，这里用自己的底部项以便接入应用内语言 -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsNavItem" Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
